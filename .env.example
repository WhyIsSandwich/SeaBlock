# Asset delivery config (build-time, Vite-injected)
# Copy to .env.local and customize. Do not commit .env.local.

# Dev (defaults work without setting these):
# VITE_ASSET_DATA_BASE_URL=          # empty = use site-relative /data/...
# VITE_ASSET_SPRITE_FORMAT=png       # png in dev

# Production (set for build/deploy after publishing):
# VITE_ASSET_DATA_BASE_URL=https://your-cdn.example.com/abc123  # include hash path for cache busting
# VITE_ASSET_SPRITE_FORMAT=webp      # webp in prod

# R2 publish (for publish-generated-data.js, CI/CD):
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=       # optional, defaults to https://<account-id>.r2.cloudflarestorage.com
# R2_PREFIX=         # optional, e.g. prod/abc123/
